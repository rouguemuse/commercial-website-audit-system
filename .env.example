# ==============================================================================
# Website Audit System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure in your deployment provider (e.g. Vercel)

# Optional: Google Gemini API Key for AI-assisted copy analysis
# If omitted, the system operates completely offline using deterministic DOM heuristics.
GEMINI_API_KEY=

# Optional: AI Model to use for analysis (default: gemini-1.5-flash)
AUDIT_MODEL=gemini-1.5-flash

# Optional: Secret key to protect the /api/crawler and /api/analyze endpoints
# If set, client requests must pass this key in the 'x-audit-key' or 'Authorization: Bearer' header.
AUDIT_SECRET=

# Optional: Port for local Node.js / Express development server (default: 3000)
PORT=3000
