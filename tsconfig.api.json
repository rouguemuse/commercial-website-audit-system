{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist-api",
    "rootDir": "./",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false
  },
  "include": ["api/**/*.ts", "src/types/**/*.ts"]
}
